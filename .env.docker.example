# Copy this file to .env before running docker compose.
# Replace every placeholder with an independently generated random value.

DB_PASSWORD=replace-with-a-strong-random-database-password
DB_HOST_PORT=5432
JWT_SECRET=replace-with-a-random-value-of-at-least-32-characters
ENCRYPTION_KEY=replace-with-an-independent-random-value-of-at-least-32-characters
BUSINESS_TIME_ZONE=Asia/Shanghai
