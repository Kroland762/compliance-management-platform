# Copy this file to .env before running docker compose.
# Replace every placeholder with an independently generated random value.

DOMAIN=compliance.example.com
LETSENCRYPT_EMAIL=ops@example.com
DB_PASSWORD=replace-with-a-strong-random-database-password
DB_HOST_PORT=5432
BACKEND_HOST_PORT=3001
FRONTEND_HOST_PORT=8080
JWT_SECRET=replace-with-a-random-value-of-at-least-32-characters
ENCRYPTION_KEY=replace-with-an-independent-random-value-of-at-least-32-characters
METRICS_TOKEN=replace-with-an-independent-random-value-of-at-least-32-characters
# Backup/restore only: keep the actual key in this 0600 file outside the repository.
BACKUP_KEY_FILE=/etc/compliance/backup.key
BACKUP_HOST_DIR=/var/backups/compliance-platform
RESTORE_HOST_DIR=/var/lib/compliance-platform/restore-uploads
BUSINESS_TIME_ZONE=Asia/Shanghai
MAX_FILE_SIZE=52428800
SCHEDULE_TASK_TIMEOUT_MS=600000
LOG_LEVEL=info
