# 合规管理平台 - 环境变量
# 复制此文件为 .env 并填写真实值

# === 服务器 ===
PORT=3001
NODE_ENV=development

# === 数据库 ===
DB_HOST=localhost
DB_PORT=5432
DB_NAME=compliance_management_platform
DB_USER=admin
DB_PASSWORD=
DB_SSL=false
DB_CA_CERT=

# === JWT（生产环境务必修改）===
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_EXPIRES_IN=1800
JWT_REFRESH_EXPIRES_IN=86400

# === 字段加密密钥（用于数据源密码加密）===
ENCRYPTION_KEY=change-me-to-another-random-64-char-string
METRICS_TOKEN=change-me-to-a-random-32-char-token

# === 前端地址 (CORS) ===
FRONTEND_URL=http://localhost:5173

# === 文件上传 ===
UPLOAD_DIR=uploads
MAX_FILE_SIZE=52428800
FILE_STORAGE_DRIVER=local
# S3-compatible adapter reserved for a later release; keep local in this version.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# === PostgreSQL 只读数据源 ===
# 默认拒绝本机、内网、链路本地和保留地址。仅在已确认网络边界时显式开启。
ALLOW_PRIVATE_DATASOURCE_HOSTS=false
SCHEDULE_TASK_TIMEOUT_MS=600000

# === 日志与备份 ===
LOG_LEVEL=info
BACKUP_DIR=./backups
BACKUP_ENCRYPTION_KEY=

# === SMTP 邮件配置（可选）===
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASS=
SMTP_FROM=noreply@example.com
