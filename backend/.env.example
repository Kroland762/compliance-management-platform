# 合规管理平台 - 环境变量
# 复制此文件为 .env 并填写真实值

# === 服务器 ===
PORT=3001
NODE_ENV=development

# === 数据库 ===
DB_HOST=localhost
DB_PORT=5432
DB_NAME=compliance_management_platform
DB_USER=admin
DB_PASSWORD=

# === JWT（生产环境务必修改）===
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_EXPIRES_IN=1800
JWT_REFRESH_EXPIRES_IN=86400

# === 字段加密密钥（用于数据源密码加密）===
ENCRYPTION_KEY=change-me-to-another-random-64-char-string
ENCRYPTION_KEY_ID=primary
# 轮换密钥时可保留旧密钥，例如 {"old-2026":"旧密钥"}
ENCRYPTION_KEYRING={}

# === 前端地址 (CORS) ===
FRONTEND_URL=http://localhost:5173

# === 文件上传 ===
UPLOAD_DIR=uploads
MAX_FILE_SIZE=52428800

# === 数据源安全 ===
# 生产默认要求数据源启用 TLS；如使用私有 CA，请填写 PEM 内容
DATA_SOURCE_CA_CERT=
# 设置为 false 可阻止连接 RFC1918 私网地址；本机、链路本地和元数据地址始终禁止
ALLOW_PRIVATE_DATA_SOURCES=true
ALLOW_INSECURE_DATA_SOURCE_TLS=false

# === 持久化任务调度 ===
TASK_SCHEDULER_TIMEZONE=Asia/Shanghai
TASK_SCHEDULER_POLL_MS=5000
TASK_SCHEDULER_STALE_LOCK_MS=600000
TASK_SCHEDULER_MAX_RETRIES=3

# === SMTP 邮件配置（可选）===
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASS=
SMTP_FROM=noreply@example.com
