# 合规管理平台 - 环境变量
# 复制此文件为 .env 并填写真实值

# === 服务器 ===
PORT=3001
NODE_ENV=development

# === 数据库 ===
DB_HOST=localhost
DB_PORT=5432
DB_NAME=compliance_management_platform
DB_USER=admin
DB_PASSWORD=

# === JWT（生产环境务必修改）===
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_EXPIRES_IN=1800
JWT_REFRESH_EXPIRES_IN=86400

# === 字段加密密钥（用于数据源密码加密）===
ENCRYPTION_KEY=change-me-to-another-random-64-char-string

# === 前端地址 (CORS) ===
FRONTEND_URL=http://localhost:5173

# === 文件上传 ===
UPLOAD_DIR=uploads
MAX_FILE_SIZE=52428800

# === SMTP 邮件配置（可选）===
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASS=
SMTP_FROM=noreply@example.com
