{
  "name": "audit-platform-backend",
  "version": "1.0.0",
  "description": "合规管理平台后端 API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate": "tsx src/config/migrate.ts up",
    "migrate:up": "tsx src/config/migrate.ts up",
    "migrate:status": "tsx src/config/migrate.ts status",
    "migrate:down": "tsx src/config/migrate.ts down",
    "migrate:legacy-public": "tsx src/config/migrate-legacy-public.ts",
    "migrate:legacy-files": "tsx src/config/migrate-legacy-files.ts",
    "migrate:membership-plan": "tsx src/config/migrate-membership-plan.ts",
    "migrate:relationship-plan": "tsx src/config/migrate-relationship-plan.ts",
    "benchmark:vnext": "tsx src/config/benchmark-vnext.ts",
    "seed": "tsx src/config/seed.ts",
    "test": "jest --runInBand",
    "test:ci": "jest --runInBand --coverage"
  },
  "dependencies": {
    "@types/cookie-parser": "^1.4.10",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "node-cron": "^4.2.1",
    "nodemailer": "^9.0.3",
    "papaparse": "^5.4.1",
    "pg": "^8.13.0",
    "pg-hstore": "^2.3.4",
    "prom-client": "^15.1.3",
    "sequelize": "^6.37.3",
    "svg-captcha": "^1.4.0",
    "uuid": "^11.1.1",
    "winston": "^3.14.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.7.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.0",
    "@types/papaparse": "^5.3.14",
    "@types/uuid": "^10.0.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.7",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.6.2"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "uuid": "^11.1.1"
  }
}
